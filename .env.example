# Copy to .env (git-ignored) and fill in. Never commit real values.
# In AWS these come from SSM Parameter Store instead.

# dry_run | paper. Defaults to dry_run; `live` is refused until Phase 8 (CLAUDE.md §3).
TRADING_MODE=dry_run
# dev | paper: names the Alpaca account / Neon branch this process belongs to (README §12).
ENVIRONMENT=dev

# Alpaca PAPER keys for the `dev` account (local work). The deployed `paper`
# environment uses a separate paper account whose keys live only in SSM.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Anthropic: set a monthly spend limit in the Console first.
ANTHROPIC_API_KEY=

FRED_API_KEY=
FINNHUB_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email.
EDGAR_USER_AGENT="AuraTrade research you@example.com"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local Postgres from docker-compose.yml, or the Neon `dev` branch. For Neon use the
# *direct* (unpooled) connection string with the psycopg driver and TLS, e.g.
#   postgresql+psycopg://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Then: uv run alembic upgrade head
DATABASE_URL=postgresql+psycopg://auratrade:auratrade@localhost:5432/auratrade

# LLM models and effort per role (README §9, §14). Effort: low | medium | high | xhigh | max.
# ANALYST_MODEL=claude-opus-5-5
# PM_MODEL=claude-opus-5-5
# EOD_MODEL=claude-opus-5-5
# WEEKLY_MODEL=claude-opus-5-5
# ANALYST_EFFORT=medium
# PM_EFFORT=high
# EOD_EFFORT=high
# WEEKLY_EFFORT=high
# ANALYST_MAX_CANDIDATES=40

# Object storage: local folder (default ./var/storage) or S3.
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=var/storage
# STORAGE_S3_BUCKET=

# Lambda function name for a chained job; `{env}` and `{job}` are substituted.
# JOB_FUNCTION_TEMPLATE=auratrade-{env}-{job}

# Thresholds live in config/risk.yaml, never here.
# RISK_CONFIG_PATH=config/risk.yaml
