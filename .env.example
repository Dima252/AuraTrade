# Copy to .env (git-ignored) and fill in. Never commit real values.
# In AWS these come from SSM Parameter Store instead.

# dry_run | paper | live. Defaults to dry_run; live is never a fallback (CLAUDE.md §3).
TRADING_MODE=dry_run

# Alpaca PAPER keys for the `dev` account (local work). The deployed `paper`
# environment uses a separate paper account whose keys live only in SSM.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Anthropic: set a monthly spend limit in the Console first.
ANTHROPIC_API_KEY=

FRED_API_KEY=
FINNHUB_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email.
EDGAR_USER_AGENT="AuraTrade research you@example.com"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local Postgres from docker-compose.yml; the Neon `dev` branch URL replaces it from task 1.2.
DATABASE_URL=postgresql+psycopg://auratrade:auratrade@localhost:5432/auratrade
