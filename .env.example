# Template for the git-ignored env files; never commit real values.
#   .env        the `dev` environment: local runs, the `dev` Alpaca account, the Neon `dev` branch
#   .env.paper  the deployed `paper` environment: its own Alpaca account and Neon `paper` branch;
#               scripts/put_parameters.py copies its keys into SSM, where the Lambdas read them
# Both files keep this layout and the same keys (README §12).

# dry_run | paper. Defaults to dry_run; `live` is refused until Phase 8 (CLAUDE.md §3).
TRADING_MODE=dry_run
# dev | paper: names the Alpaca account / Neon branch this process belongs to (README §12).
ENVIRONMENT=dev

# Alpaca PAPER keys: one paper account per environment (the scheduler of one must never
# trade against the other's positions; put_parameters refuses `dev`'s key for `paper`).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Anthropic: set a monthly spend limit in the Console first.
ANTHROPIC_API_KEY=

FRED_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# healthchecks.io ping URL: the watchdog's external dead-man's switch (README §5.13).
# Needed only where the watchdog runs (the deployed `paper` env); keep it private.
HEALTHCHECKS_PING_URL=

# Local Postgres from docker-compose.yml, or the environment's Neon branch. For Neon use the
# *direct* (unpooled) connection string with the psycopg driver and TLS, e.g.
#   postgresql+psycopg://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Then: uv run alembic upgrade head
DATABASE_URL=postgresql+psycopg://auratrade:auratrade@localhost:5432/auratrade

# The Portfolio Manager's model and effort (README §9, §14). Effort: low | medium | high | xhigh | max.
# PM_MODEL=claude-opus-5-5
# PM_EFFORT=high

# Object storage: local folder (default ./var/storage) or S3.
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=var/storage
# STORAGE_S3_BUCKET=

# Lambda function name for a chained job; `{env}` and `{job}` are substituted.
# JOB_FUNCTION_TEMPLATE=auratrade-{env}-{job}

# Thresholds live in config/risk.yaml, never here.
# RISK_CONFIG_PATH=config/risk.yaml
